# Files that must be present in the source distribution (sdist) in addition to
# the Python packages: the web UI (also declared as package-data), docs, tests,
# operator scripts and the release/community files. tests/test_packaging.py and
# the CI build job assert the important ones are present.

include LICENSE
include README.md
include CHANGELOG.md
include SECURITY.md
include SUPPORT.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include THIRD-PARTY-NOTICES.md
include pyproject.toml
include MANIFEST.in
include .env.example

recursive-include docs *.md
recursive-include tests *.py
recursive-include scripts *.sh *.py
recursive-include peekseed/web *
recursive-include .github *.yml *.md

# Never ship bytecode caches, local runtime state or build leftovers.
global-exclude __pycache__ *.py[cod] *.egg-info
prune workspace
prune peekseed.egg-info
prune build
prune dist
