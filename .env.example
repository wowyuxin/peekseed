# peekseed -- configuration template
#
# Copy to `.env` (or export these variables) before running. Everything is
# optional: the defaults are a localhost server with a ./data root.
#
#   cp .env.example .env
#
# A variable already present in the environment wins over this file.

# --- data root: every mutable path lives under one directory ---------------
# Datasets, indexes, history and the model-link config. Relative paths resolve
# against the current working directory.
# PEEKSEED_DATA=./data

# --- server ----------------------------------------------------------------
# Loopback by default: peekseed has no authentication in this step. Only set
# 0.0.0.0 when you deliberately want it reachable from another machine on a
# trusted network.
# PEEKSEED_HOST=127.0.0.1
# PEEKSEED_PORT=8030

# --- model links (optional; the UI is the normal way to configure them) ----
# On first run these seed one link per role. No endpoint, model or key is
# required, and no value is ever sent back to the browser.
#
# Embedding: protocol is "openai" (POST /embeddings) or "custom" (POST /embed).
# PEEKSEED_EMBED_BASE=http://127.0.0.1:11434/v1
# PEEKSEED_EMBED_PROTOCOL=openai
# PEEKSEED_EMBED_MODEL=nomic-embed-text
# PEEKSEED_EMBED_API_KEY=
#
# Optional reranker: POST /rerank, scores aligned with documents.
# PEEKSEED_RERANK_BASE=http://127.0.0.1:8085
# PEEKSEED_RERANK_MODEL=
# PEEKSEED_RERANK_API_KEY=
#
# Answer model: an OpenAI-compatible /chat/completions endpoint.
# PEEKSEED_ANSWER_BASE=http://127.0.0.1:11434/v1
# PEEKSEED_ANSWER_MODEL=llama3.1
# PEEKSEED_ANSWER_API_KEY=

# --- answer + research knobs ----------------------------------------------
# PEEKSEED_ASK_MAX_CHUNKS=8
# PEEKSEED_ASK_MAX_CHARS=6000
# PEEKSEED_ASK_MAX_TOKENS=4096
# PEEKSEED_ASK_TEMPERATURE=0.2
# PEEKSEED_RERANK_POOL=20
# PEEKSEED_RERANK_BATCH=8

# --- agent / research mode (off by default) -------------------------------
# PEEKSEED_AGENT=1
# PEEKSEED_AGENT_MAX_STEPS=6
# PEEKSEED_AGENT_MAX_TOOL_CALLS=12
# PEEKSEED_AGENT_WALL_SEC=240
